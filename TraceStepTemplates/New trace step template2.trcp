	<PARAMETERS xsi:type="trcpParameterDescriptionList">
		<PARAMETER uuid="ff45dd52e29b11eeb60734cff6f2e990" xsi:type="parameterDescription">
			<NAME xsi:type="string">MinMaxSuccessfulInstances</NAME>
			<DESCRIPTION xsi:type="string">Specifies how often the timing diagram must run successfully.
The value can be a number or a range (two comma-separated values in parentheses).
For value &quot;None&quot;, the appropriate boundary will not be checked.</DESCRIPTION>
			<PARAMETER-TYPE xsi:type="string">PYOBJECT</PARAMETER-TYPE>
		</PARAMETER>
		<PARAMETER uuid="ff45dd53e29b11eebb0e34cff6f2e990" xsi:type="parameterDescription">
			<NAME xsi:type="string">AllowFailedInstances</NAME>
			<DESCRIPTION xsi:type="string">Specifies if the timing diagram can fail.
The value has to be a boolean value (True or False). None is also valid here and means False.</DESCRIPTION>
			<PARAMETER-TYPE xsi:type="string">PYOBJECT</PARAMETER-TYPE>
		</PARAMETER>
		<PARAMETER uuid="ff45dd54e29b11eebfe434cff6f2e990" xsi:type="parameterDescription">
			<NAME xsi:type="string">MaxParallelInstances</NAME>
			<DESCRIPTION xsi:type="string">Maximum number of diagram instances that can be evaluated in parallel. A value &lt;= 0 indicates no limitation. None is also valid here and means 1.</DESCRIPTION>
			<PARAMETER-TYPE xsi:type="string">INTEGER</PARAMETER-TYPE>
		</PARAMETER>
	</PARAMETERS>
