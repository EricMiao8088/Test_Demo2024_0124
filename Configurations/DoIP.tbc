								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">0xFF</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">Timeout</NAME>
								<DESCRIPTION xsi:type="string">Timeout (ms) after which the diagnostic system aborts waiting for diagnostic response (optional) - Integer (&gt;=0)</DESCRIPTION>
