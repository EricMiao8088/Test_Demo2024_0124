							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">searchValue</NAME>
								<DISPLAY-NAME xsi:type="string">Element</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The value that identifies the element to click onto, according to the search method.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">xDistance</NAME>
								<DISPLAY-NAME xsi:type="string">Distance (left/right)</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The number of pixels to scroll.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">yDistance</NAME>
								<DISPLAY-NAME xsi:type="string">Distance (up/down)</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The number of pixels to scroll.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Scrolls by the requested distance in the given element - up (or to the left) for a given negative distance, down (or to the right) otherwise.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
