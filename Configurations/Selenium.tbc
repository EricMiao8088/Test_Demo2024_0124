								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Closes the specified window.</DESCRIPTION>
						<RETURN xsi:type="propertyDescriptor">
							<NAME xsi:type="string">success</NAME>
							<DESCRIPTION xsi:type="string">Returns whether the closing of the window was successful.</DESCRIPTION>
							<TYPE xsi:type="string">bool</TYPE>
							<DOMAIN>
								<ELEMENT xsi:type="string">False</ELEMENT>
								<ELEMENT xsi:type="string">True</ELEMENT>
							</DOMAIN>
							<READONLY xsi:type="boolean">False</READONLY>
							<INVALID-AT xsi:type="string"/>
							<DEPRECATION-MESSAGE xsi:type="string"/>
						</RETURN>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">MoveMouseOverElement</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">searchMethod</NAME>
								<DISPLAY-NAME xsi:type="string">Search method</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The method by which the element is identified.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<DOMAIN>
									<ELEMENT xsi:type="string">id</ELEMENT>
									<ELEMENT xsi:type="string">xpath</ELEMENT>
									<ELEMENT xsi:type="string">link text</ELEMENT>
									<ELEMENT xsi:type="string">partial link text</ELEMENT>
									<ELEMENT xsi:type="string">name</ELEMENT>
									<ELEMENT xsi:type="string">tag name</ELEMENT>
									<ELEMENT xsi:type="string">class name</ELEMENT>
									<ELEMENT xsi:type="string">css selector</ELEMENT>
								</DOMAIN>
								<DEFAULT xsi:type="string">id</DEFAULT>
								<READONLY xsi:type="boolean">True</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">searchValue</NAME>
								<DISPLAY-NAME xsi:type="string">Element</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The value that identifies the element to click onto, according to the search method.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">timeout</NAME>
								<DISPLAY-NAME xsi:type="string">Timeout</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">Timeout to wait for the element; -1 for default value from test bench configuration.</DESCRIPTION>
								<TYPE xsi:type="string">float</TYPE>
								<DEFAULT xsi:type="string">-1.0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Moves the mouse to the first element found.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">SetWindowSize</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">mode</NAME>
								<DISPLAY-NAME xsi:type="string">Window mode</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">Custom value, &quot;maximized&quot;, &quot;minimized&quot; or default value from test bench configuration</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<DOMAIN>
									<ELEMENT xsi:type="string">From test bench configuration</ELEMENT>
									<ELEMENT xsi:type="string">Maximized</ELEMENT>
									<ELEMENT xsi:type="string">Minimized</ELEMENT>
									<ELEMENT xsi:type="string">User defined</ELEMENT>
								</DOMAIN>
								<DEFAULT xsi:type="string">From test bench configuration</DEFAULT>
								<READONLY xsi:type="boolean">True</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">windowHeight</NAME>
								<DISPLAY-NAME xsi:type="string">Window height</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">Window height in pixels for &quot;User defined&quot; mode.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">windowWidth</NAME>
								<DISPLAY-NAME xsi:type="string">Window width</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">Window width in pixels for &quot;User defined&quot; mode.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Changes the size of the browser window.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">DragAndDropByOffset</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">searchMethod</NAME>
								<DISPLAY-NAME xsi:type="string">Search method</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The method by which the element is identified.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<DOMAIN>
									<ELEMENT xsi:type="string">id</ELEMENT>
									<ELEMENT xsi:type="string">xpath</ELEMENT>
									<ELEMENT xsi:type="string">link text</ELEMENT>
									<ELEMENT xsi:type="string">partial link text</ELEMENT>
									<ELEMENT xsi:type="string">name</ELEMENT>
									<ELEMENT xsi:type="string">tag name</ELEMENT>
									<ELEMENT xsi:type="string">class name</ELEMENT>
									<ELEMENT xsi:type="string">css selector</ELEMENT>
								</DOMAIN>
								<DEFAULT xsi:type="string">id</DEFAULT>
								<READONLY xsi:type="boolean">True</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">searchValue</NAME>
								<DISPLAY-NAME xsi:type="string">Element</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The value that identifies the element to click onto, according to the search method.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">timeout</NAME>
								<DISPLAY-NAME xsi:type="string">Timeout</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">Timeout to wait for the element; -1 for default value from test bench configuration.</DESCRIPTION>
								<TYPE xsi:type="string">float</TYPE>
								<DEFAULT xsi:type="string">-1.0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">offsetX</NAME>
								<DISPLAY-NAME xsi:type="string">Offset X</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">Number of pixels in horizontal direction.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">offsetY</NAME>
								<DISPLAY-NAME xsi:type="string">Offset Y</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">Number of pixels in vertical direction.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Performs a drag and drop on an element in the specified direction.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
				</JOBS>
			</DVALUE>
		</PORT-DESCRIPTOR>
	</PORT-DESCRIPTORS>
</TOOLING>
