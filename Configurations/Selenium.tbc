<?xml version="1.0" encoding="utf-8"?>
<TOOLING format-rev="3" prog-version="2024.2.0.151174+1c1d96a477d2" xmlns="http://www.tracetronic.de/xml/ecu-test" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.tracetronic.de/xml/ecu-test tooling.xsd">
	<TOOL-HOSTS>
		<TOOL-HOST xsi:type="toolHost">
			<URL xsi:type="string">local</URL>
			<PLATFORM xsi:type="string">Windows</PLATFORM>
			<BASE-PATH xsi:type="string">&lt;workspace&gt;</BASE-PATH>
		</TOOL-HOST>
	</TOOL-HOSTS>
	<TOOLS>
		<TOOL id="SELENIUM01" xsi:type="tool">
			<TOOL-HOST xsi:type="string">local</TOOL-HOST>
			<TOOL-NAME xsi:type="string">SELENIUM</TOOL-NAME>
			<START-OPTION xsi:type="integer">0</START-OPTION>
			<START-PRIORITY xsi:type="integer">0</START-PRIORITY>
			<SETTINGS xsi:type="dynamicPropertySet"/>
		</TOOL>
	</TOOLS>
	<PORTS>
		<PORT format-rev="2" id="IMG-DEFAULT01" toolId="SELENIUM01" xsi:type="port">
			<PORT-TYPE-ID format-rev="2" xsi:type="toolcaps">
				<NAME xsi:type="string">IMAGE</NAME>
			</PORT-TYPE-ID>
			<IMPL-TYPE-ID xsi:type="string">DEFAULT</IMPL-TYPE-ID>
			<AUTOSTART xsi:type="integer">0</AUTOSTART>
			<SETTINGS xsi:type="dynamicPropertySet">
				<PROPERTY format-rev="1" name="BrowserChoice" propertyType="string" readonly="false" xsi:type="_property">
					<VALUE xsi:type="string">Edge</VALUE>
				</PROPERTY>
				<PROPERTY format-rev="1" name="BrowserPath" propertyType="string" readonly="false" xsi:type="_property">
					<VALUE xsi:type="string">C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe</VALUE>
				</PROPERTY>
				<PROPERTY format-rev="1" name="WebDriverPath" propertyType="string" readonly="false" xsi:type="_property">
					<VALUE xsi:type="string">C:\ET2024_2\edgedriver_win64\msedgedriver.exe</VALUE>
				</PROPERTY>
			</SETTINGS>
		</PORT>
	</PORTS>
	<TOOL-DESCRIPTORS>
		<TOOL-DESCRIPTOR dkey="SELENIUM01">
			<DVALUE format-rev="2" xsi:type="toolDescriptor">
				<TOOL-NAME xsi:type="string">SELENIUM</TOOL-NAME>
				<PROVIDES>
					<PORT-TYPE xsi:type="portImplInfo">
						<PORT-TYPE-ID format-rev="2" xsi:type="toolcaps">
							<NAME xsi:type="string">IMAGE</NAME>
						</PORT-TYPE-ID>
						<IMPL-TYPE xsi:type="implTypeDescriptor">
							<IMPL-TYPE-ID xsi:type="string">DEFAULT</IMPL-TYPE-ID>
							<DESCRIPTION xsi:type="string">Standard port for browser interaction</DESCRIPTION>
						</IMPL-TYPE>
					</PORT-TYPE>
				</PROVIDES>
				<START-PRIORITY-HINT xsi:type="integer">0</START-PRIORITY-HINT>
				<PROPERTIES xsi:type="propertyDescriptorSet">
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">ToolAccessTimeout</NAME>
						<DISPLAY-NAME xsi:type="string">Timeout for tool call (in sec.)</DISPLAY-NAME>
						<DESCRIPTION xsi:type="string">Timeout after which a tool call is aborted.</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<DEFAULT xsi:type="string">600</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
				</PROPERTIES>
				<JOBS xsi:type="jobDescriptorSet"/>
			</DVALUE>
		</TOOL-DESCRIPTOR>
	</TOOL-DESCRIPTORS>
	<PORT-DESCRIPTORS>
		<PORT-DESCRIPTOR dkey="IMG-DEFAULT01">
			<DVALUE format-rev="1" xsi:type="portDescriptor">
				<PORT-TYPE-ID format-rev="2" xsi:type="toolcaps">
					<NAME xsi:type="string">IMAGE</NAME>
				</PORT-TYPE-ID>
				<IMPL-TYPE-ID xsi:type="string">DEFAULT</IMPL-TYPE-ID>
				<PROPERTIES xsi:type="propertyDescriptorSet">
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">BrowserChoice</NAME>
						<DISPLAY-NAME xsi:type="string">Browser</DISPLAY-NAME>
						<DESCRIPTION xsi:type="string">Browser selection. Browser path and WebDriver path must match the selection.</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<DOMAIN>
							<ELEMENT xsi:type="string">Firefox</ELEMENT>
							<ELEMENT xsi:type="string">Chrome</ELEMENT>
							<ELEMENT xsi:type="string">Edge</ELEMENT>
						</DOMAIN>
						<DEFAULT xsi:type="string">Firefox</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">BrowserPath</NAME>
						<DISPLAY-NAME xsi:type="string">Browser path</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Absolute installation path to the browser.</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">BrowserProfile</NAME>
						<DISPLAY-NAME xsi:type="string">Browser profile path</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Optional: Absolute path to the used browser profile</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">BrowserExtensions</NAME>
						<DISPLAY-NAME xsi:type="string">Browser extensions</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Optional: Comma-separated paths to browser extensions.
Paths can be absolute or relative to the tool host base path.</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">BrowserWidth</NAME>
						<DISPLAY-NAME xsi:type="string">Browser width</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Width of the browser window in pixels.</DESCRIPTION>
						<TYPE xsi:type="string">int</TYPE>
						<DEFAULT xsi:type="string">800</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">BrowserHeight</NAME>
						<DISPLAY-NAME xsi:type="string">Browser height</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Height of the browser window in pixels.</DESCRIPTION>
						<TYPE xsi:type="string">int</TYPE>
						<DEFAULT xsi:type="string">600</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">WebDriverPath</NAME>
						<DISPLAY-NAME xsi:type="string">WebDriver path</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Installation path to the Webdriver.
Path can be absolute or relative to the tool host base path.</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">ImplicitTimeout</NAME>
						<DISPLAY-NAME xsi:type="string">Implicit timeout</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Timeout in seconds, which applies to all steps unless specified otherwise in the step.</DESCRIPTION>
						<TYPE xsi:type="string">float</TYPE>
						<DEFAULT xsi:type="string">10</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">StartHeadless</NAME>
						<DISPLAY-NAME xsi:type="string">Headless mode</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Starts the browser in headless mode (without visible window).</DESCRIPTION>
						<TYPE xsi:type="string">bool</TYPE>
						<DOMAIN>
							<ELEMENT xsi:type="string">False</ELEMENT>
							<ELEMENT xsi:type="string">True</ELEMENT>
						</DOMAIN>
						<DEFAULT xsi:type="string">False</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">livestreamViewerEnabled</NAME>
						<DISPLAY-NAME xsi:type="string">Live preview</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Streams a live preview on the configured network port. The live stream is available under the toolhost's IP address and the configured port, e.g. for a local tool connection: http://127.0.0.1:&lt;port&gt;</DESCRIPTION>
						<TYPE xsi:type="string">checkGroup</TYPE>
						<DEFAULT xsi:type="string">False</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">livestreamViewerWindowEnabled</NAME>
						<DISPLAY-NAME xsi:type="string">Open preview window</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Opens a preview window upon StartBrowser job execution. This window displays the current output of the image source as a livestream and will remain open until StopBrowser job execution.</DESCRIPTION>
						<TYPE xsi:type="string">checkGroup</TYPE>
						<DEFAULT xsi:type="string">True</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<GROUP xsi:type="string">livestreamViewerEnabled</GROUP>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">livestreamViewerPort</NAME>
						<DISPLAY-NAME xsi:type="string">Port</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">The network port that will be used for live streaming. Every live stream needs an unique port if live streaming is enabled for multiple video sources. If the value is set to &lt;auto&gt; a free network port will be defined by the system.</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<DEFAULT xsi:type="string">&lt;auto&gt;</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<GROUP xsi:type="string">livestreamViewerEnabled</GROUP>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">videoOverlayEnabled</NAME>
						<DISPLAY-NAME xsi:type="string">Show text overlay in video recordings</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Adds a text overlay with the format &quot;timestamp package name&quot; in the bottom left corner of video recordings.</DESCRIPTION>
						<TYPE xsi:type="string">checkGroup</TYPE>
						<DEFAULT xsi:type="string">False</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
				</PROPERTIES>
				<JOBS xsi:type="jobDescriptorSet">
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">StartBrowser</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet"/>
						<DESCRIPTION xsi:type="string">Starts the browser instance.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">StopBrowser</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet"/>
						<DESCRIPTION xsi:type="string">Stops the browser instance.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB format-rev="2" xsi:type="jobDescriptor">
						<NAME xsi:type="string">OpenUrl</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">url</NAME>
								<DISPLAY-NAME xsi:type="string">URL</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The complete web address.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">windowType</NAME>
								<DISPLAY-NAME xsi:type="string">Type of target window</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">Type of window in which the URL should be opened.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<DOMAIN>
									<ELEMENT xsi:type="string">Current window</ELEMENT>
									<ELEMENT xsi:type="string">Selected window</ELEMENT>
									<ELEMENT xsi:type="string">New window</ELEMENT>
									<ELEMENT xsi:type="string">New tab</ELEMENT>
								</DOMAIN>
								<DEFAULT xsi:type="string">Current window</DEFAULT>
								<READONLY xsi:type="boolean">True</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">windowName</NAME>
								<DISPLAY-NAME xsi:type="string">Existing target window</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The name of the window in which the URL should be opened.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Opens the given web site (URL).</DESCRIPTION>
						<RETURN xsi:type="propertyDescriptor">
							<NAME xsi:type="string">windowHandle</NAME>
							<DESCRIPTION xsi:type="string">The identifier of the window.</DESCRIPTION>
							<TYPE xsi:type="string">string</TYPE>
							<READONLY xsi:type="boolean">False</READONLY>
							<INVALID-AT xsi:type="string"/>
							<DEPRECATION-MESSAGE xsi:type="string"/>
						</RETURN>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">GoBack</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet"/>
						<DESCRIPTION xsi:type="string">Displays the previous page again.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">SwitchToFrame</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">identifier</NAME>
								<DESCRIPTION xsi:type="string">Index, name or ID of the iframe.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Moves focus to an iframe for locating elements therein.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">SwitchToDefaultContent</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet"/>
						<DESCRIPTION xsi:type="string">Moves focus back to the main content after an iframe has been selected.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">ClickElement</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">searchMethod</NAME>
								<DISPLAY-NAME xsi:type="string">Search method</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The method by which the element is identified.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<DOMAIN>
									<ELEMENT xsi:type="string">id</ELEMENT>
									<ELEMENT xsi:type="string">xpath</ELEMENT>
									<ELEMENT xsi:type="string">link text</ELEMENT>
									<ELEMENT xsi:type="string">partial link text</ELEMENT>
									<ELEMENT xsi:type="string">name</ELEMENT>
									<ELEMENT xsi:type="string">tag name</ELEMENT>
									<ELEMENT xsi:type="string">class name</ELEMENT>
									<ELEMENT xsi:type="string">css selector</ELEMENT>
								</DOMAIN>
								<DEFAULT xsi:type="string">id</DEFAULT>
								<READONLY xsi:type="boolean">True</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">searchValue</NAME>
								<DISPLAY-NAME xsi:type="string">Element</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The value that identifies the element to click onto, according to the search method.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">timeout</NAME>
								<DISPLAY-NAME xsi:type="string">Timeout</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">Timeout to wait for the element; -1 for default value from test bench configuration.</DESCRIPTION>
								<TYPE xsi:type="string">float</TYPE>
								<DEFAULT xsi:type="string">-1.0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Clicks onto the requested element.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">ClickPosition</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">positionX</NAME>
								<DISPLAY-NAME xsi:type="string">X location</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The X location of the position.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">positionY</NAME>
								<DISPLAY-NAME xsi:type="string">Y location</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The Y location of the position.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Clicks onto the requested position.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">WriteText</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">text</NAME>
								<DISPLAY-NAME xsi:type="string">Text</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The text that has to be typed.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">pressEnter</NAME>
								<DISPLAY-NAME xsi:type="string">Concluding enter</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">If True, Enter is pressed after the input.</DESCRIPTION>
								<TYPE xsi:type="string">bool</TYPE>
								<DOMAIN>
									<ELEMENT xsi:type="string">False</ELEMENT>
									<ELEMENT xsi:type="string">True</ELEMENT>
								</DOMAIN>
								<DEFAULT xsi:type="string">False</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Types the given text at the current cursor position.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">SendKey</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">key</NAME>
								<DISPLAY-NAME xsi:type="string">Button</DISPLAY-NAME>
								<DESCRIPTION xsi:type="string">The key to be pressed.</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<DOMAIN>
									<ELEMENT xsi:type="string">ADD</ELEMENT>
									<ELEMENT xsi:type="string">ALT</ELEMENT>
									<ELEMENT xsi:type="string">ARROW_DOWN</ELEMENT>
									<ELEMENT xsi:type="string">ARROW_LEFT</ELEMENT>
									<ELEMENT xsi:type="string">ARROW_RIGHT</ELEMENT>
									<ELEMENT xsi:type="string">ARROW_UP</ELEMENT>
									<ELEMENT xsi:type="string">BACKSPACE</ELEMENT>
									<ELEMENT xsi:type="string">BACK_SPACE</ELEMENT>
									<ELEMENT xsi:type="string">CANCEL</ELEMENT>
