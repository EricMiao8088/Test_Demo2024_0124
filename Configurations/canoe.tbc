								<NAME xsi:type="string">isExtended</NAME>
								<DESCRIPTION xsi:type="string">Address format: True for 29 bit, False for 11 bit, None uses the setting &quot;Mode&quot; from the test bench configuration</DESCRIPTION>
								<TYPE xsi:type="string">bool</TYPE>
