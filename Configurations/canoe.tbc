							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">CfgFile</NAME>
								<DESCRIPTION xsi:type="string">Configuration file to be loaded. Using the TBC information if the value is not set or an empty string.</DESCRIPTION>
