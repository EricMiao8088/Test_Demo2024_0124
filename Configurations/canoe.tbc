		<PORT-DESCRIPTOR dkey="BUS-CAN_MANIP01">
			<DVALUE format-rev="1" xsi:type="portDescriptor">
				<PORT-TYPE-ID format-rev="2" xsi:type="toolcaps">
					<NAME xsi:type="string">BUSACCESS</NAME>
				</PORT-TYPE-ID>
				<IMPL-TYPE-ID xsi:type="string">CAN_MANIP</IMPL-TYPE-ID>
				<BUS-TYPES>
					<ELEMENT xsi:type="string">AccessManipulation</ELEMENT>
				</BUS-TYPES>
				<PROPERTIES xsi:type="propertyDescriptorSet">
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">CtrlNumber</NAME>
						<DISPLAY-NAME xsi:type="string">Channel number</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Selection of channel number if there is more than one controller of same type.</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<DEFAULT xsi:type="string">1</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">Bitrate</NAME>
						<DISPLAY-NAME xsi:type="string">Bit rate</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Bit rate</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<DOMAIN>
							<ELEMENT xsi:type="string">10KB</ELEMENT>
							<ELEMENT xsi:type="string">20KB</ELEMENT>
							<ELEMENT xsi:type="string">50KB</ELEMENT>
							<ELEMENT xsi:type="string">83.333KB</ELEMENT>
							<ELEMENT xsi:type="string">100KB</ELEMENT>
							<ELEMENT xsi:type="string">125KB</ELEMENT>
							<ELEMENT xsi:type="string">250KB</ELEMENT>
							<ELEMENT xsi:type="string">500KB</ELEMENT>
							<ELEMENT xsi:type="string">666.667KB</ELEMENT>
							<ELEMENT xsi:type="string">800KB</ELEMENT>
							<ELEMENT xsi:type="string">1000KB</ELEMENT>
						</DOMAIN>
						<DEFAULT xsi:type="string">500KB</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">rbsStayActive</NAME>
						<DISPLAY-NAME xsi:type="string">Do not stop RBS</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Restbus simulation stays active beyond test case execution.</DESCRIPTION>
						<TYPE xsi:type="string">bool</TYPE>
						<DOMAIN>
							<ELEMENT xsi:type="string">False</ELEMENT>
							<ELEMENT xsi:type="string">True</ELEMENT>
						</DOMAIN>
						<DEFAULT xsi:type="string">False</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">TransferMode</NAME>
						<DISPLAY-NAME xsi:type="string">Mode</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">1</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Addressing mode (Standard = 11bit, Extended = 29bit)</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<DOMAIN>
							<ELEMENT xsi:type="string">Standard</ELEMENT>
							<ELEMENT xsi:type="string">Extended</ELEMENT>
							<ELEMENT xsi:type="string">All</ELEMENT>
						</DOMAIN>
						<DEFAULT xsi:type="string">Standard</DEFAULT>
						<READONLY xsi:type="boolean">False</READONLY>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</PROP>
					<PROP xsi:type="propertyDescriptor">
						<NAME xsi:type="string">ListenMode</NAME>
						<DISPLAY-NAME xsi:type="string">Listen only</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">1</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Controller is running in passive mode. Automatic ACK is disabled, and sending CAN frames is not possible.</DESCRIPTION>
