						</RETURN>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB xsi:type="jobDescriptor">
						<NAME xsi:type="string">SetDiagTimeout</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">SessionId</NAME>
								<DESCRIPTION xsi:type="string">Handle of the diagnostic session. This can be either the name of the SUT specified in the TCF, the handle returned by the OpenDiagSession job or None (can only be used if there is one SUT specified).</DESCRIPTION>
								<TYPE xsi:type="string">object</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">DiagTimeout</NAME>
								<DESCRIPTION xsi:type="string">Timeout (ms). If this value is set to None, the timeout will be reset to the initial value when the session was opened.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Set the timeout for the diagnostic session. Note: When setting the timeout while a diagnostic request is in progress, the timing behaviour can be unpredictable.

This job is part of the Add-on ecu.test diagnostics.</DESCRIPTION>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB format-rev="2" xsi:type="jobDescriptor">
						<NAME xsi:type="string">CallServiceFunctional</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">Request</NAME>
								<DESCRIPTION xsi:type="string">Diagnostic service request to be sent (:api:`ByteStream &lt;general_api/variabledatastructures.html#bytestream&gt;`)</DESCRIPTION>
								<TYPE xsi:type="string">ByteStream</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">SessionId</NAME>
								<DESCRIPTION xsi:type="string">Handle of the diagnostic session. This can be either the name of the SUT specified in the TCF, the handle returned by the OpenDiagSession job or None (can only be used if there is one SUT specified).</DESCRIPTION>
								<TYPE xsi:type="string">object</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">Timeout</NAME>
								<DESCRIPTION xsi:type="string">Timeout (ms) after the diagnostic system aborts waiting for a diagnostic response (optional) - Must be greater than the send confirmation timeout</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Calls any diagnostic service via functional addressing
Example: To call the UDS Service Read Data by Identifier (SID=0x22, DID=0xACDC) the Request is ByteStream(&quot;22 AC DC&quot;)</DESCRIPTION>
						<RETURN xsi:type="propertyDescriptor">
							<NAME xsi:type="string">Return</NAME>
							<DESCRIPTION xsi:type="string">List of diagnostic results (:api:`DiagResult &lt;general_api/diagdatastructures.html#ttRawDiag.diag.DiagResult.DiagResult&gt;` or :api:`NegativeResponse &lt;general_api/diagdatastructures.html#tts.tooling.common.genericBusAccess.busHw.diag.NegativeResponse.NegativeResponse&gt;`).</DESCRIPTION>
							<TYPE xsi:type="string">object</TYPE>
							<READONLY xsi:type="boolean">False</READONLY>
							<INVALID-AT xsi:type="string"/>
							<DEPRECATION-MESSAGE xsi:type="string"/>
						</RETURN>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
					<JOB format-rev="2" xsi:type="jobDescriptor">
						<NAME xsi:type="string">OpenDiagSession</NAME>
						<PARAMETERS xsi:type="parameterDescriptorSet">
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">targetIp</NAME>
								<DESCRIPTION xsi:type="string">IP address of the DoIP entity</DESCRIPTION>
								<TYPE xsi:type="string">string</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">eid</NAME>
								<DESCRIPTION xsi:type="string">ID of the DoIP entity to which a connection is to be established. If specified, a vehicle identification request is sent to this ID to establish the connection. If not, a general vehicle identification request is sent and a connection is established with the first responding control unit.</DESCRIPTION>
								<TYPE xsi:type="string">ByteStream</TYPE>
								<DEFAULT xsi:type="string">ByteStream(&quot;&quot;)</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">targetAddress</NAME>
								<DESCRIPTION xsi:type="string">The diagnostic address of the DoIP entity(ies). If specified, no vehicle identification request is sent and UDS requests are sent directly to this address.</DESCRIPTION>
								<TYPE xsi:type="string">ByteStream</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">sourceAddress</NAME>
								<DESCRIPTION xsi:type="string">The diagnostic address from which diagnostic messages are sent</DESCRIPTION>
								<TYPE xsi:type="string">ByteStream</TYPE>
								<DEFAULT xsi:type="string">ByteStream(&quot;&quot;)</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">remotePort</NAME>
								<DESCRIPTION xsi:type="string">Destination port on which the DoIP entity receives diagnostic requests</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">13400</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">listenPort</NAME>
								<DESCRIPTION xsi:type="string">Port on which to expect responses from the DoIP entity.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">0</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">doIpVersion</NAME>
								<DESCRIPTION xsi:type="string">Version of the DoIP protocol</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">2</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">activateRouting</NAME>
								<DESCRIPTION xsi:type="string">Indicates whether the DoIP entity shall forward diagnostic messages to an internal device - Boolean</DESCRIPTION>
								<TYPE xsi:type="string">bool</TYPE>
								<DOMAIN>
									<ELEMENT xsi:type="string">False</ELEMENT>
									<ELEMENT xsi:type="string">True</ELEMENT>
								</DOMAIN>
								<DEFAULT xsi:type="string">False</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">activationType</NAME>
								<DESCRIPTION xsi:type="string">Routing type in case of routing activation (e..b 0x00 -&gt; default, 0x01 -&gt; WWH-OBD, 0xE0 -&gt; Central Security, further values can be taken from the standard)</DESCRIPTION>
								<TYPE xsi:type="string">ByteStream</TYPE>
								<DEFAULT xsi:type="string">ByteStream(&quot;00&quot;)</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">diagTimeout</NAME>
								<DESCRIPTION xsi:type="string">Timeout (ms) after the diagnostic system aborts waiting for a diagnostic response (optional) - Must be greater than the send confirmation timeout</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">5000</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">startRequest</NAME>
								<DESCRIPTION xsi:type="string">Diagnostic request to open a session</DESCRIPTION>
								<TYPE xsi:type="string">ByteStream</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">stopRequest</NAME>
								<DESCRIPTION xsi:type="string">Diagnostic request to end a session</DESCRIPTION>
								<TYPE xsi:type="string">ByteStream</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">testerPresentRequest</NAME>
								<DESCRIPTION xsi:type="string">Diagnostic request for periodic tester-available signaling</DESCRIPTION>
								<TYPE xsi:type="string">ByteStream</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">testerPresentCycleTime</NAME>
								<DESCRIPTION xsi:type="string">Interval for periodic tester-present signaling (in ms)</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">retryOnBusy</NAME>
								<DESCRIPTION xsi:type="string">Number of retries in case of error (-1 for infinity)</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<DEFAULT xsi:type="string">-1</DEFAULT>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
							<PARAM xsi:type="propertyDescriptor">
								<NAME xsi:type="string">retryDelay</NAME>
								<DESCRIPTION xsi:type="string">Delay in ms between retries. With None, the delay is approx. 300 ms.</DESCRIPTION>
								<TYPE xsi:type="string">int</TYPE>
								<READONLY xsi:type="boolean">False</READONLY>
								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Opens a UDS diagnostic session which uses DoIP</DESCRIPTION>
						<RETURN xsi:type="propertyDescriptor">
							<NAME xsi:type="string">SessionId</NAME>
							<DESCRIPTION xsi:type="string">Handle of the diagnostic session</DESCRIPTION>
							<TYPE xsi:type="string">int</TYPE>
							<READONLY xsi:type="boolean">False</READONLY>
							<INVALID-AT xsi:type="string"/>
							<DEPRECATION-MESSAGE xsi:type="string"/>
						</RETURN>
						<INVALID-AT xsi:type="string"/>
						<DEPRECATION-MESSAGE xsi:type="string"/>
					</JOB>
				</JOBS>
			</DVALUE>
		</PORT-DESCRIPTOR>
		<PORT-DESCRIPTOR dkey="DIAG-DOIP-SOCKET01">
			<DVALUE format-rev="1" xsi:type="portDescriptor">
				<PORT-TYPE-ID format-rev="2" xsi:type="toolcaps">
					<NAME xsi:type="string">DIAGNOSTICS</NAME>
				</PORT-TYPE-ID>
