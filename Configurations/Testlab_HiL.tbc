								<INVALID-AT xsi:type="string"/>
								<DEPRECATION-MESSAGE xsi:type="string"/>
							</PARAM>
						</PARAMETERS>
						<DESCRIPTION xsi:type="string">Authentication (0x29) AuthenticationConfiguration: Indicates the provided authentication configuration of the server.

This job is part of the Add-on ecu.test diagnostics.</DESCRIPTION>
						<RETURN xsi:type="propertyDescriptor">
							<NAME xsi:type="string">Return</NAME>
							<DESCRIPTION xsi:type="string">Result of diagnose service call - :api:`AuthenticationConfigurationResult &lt;general_api/diagdatastructures.html#tts.tooling.common.genericBusAccess.busHw.diag.AuthenticationResult.AuthenticationConfigurationResult&gt;` - or :api:`NegativeResponse &lt;general_api/diagdatastructures.html#tts.tooling.common.genericBusAccess.busHw.diag.NegativeResponse.NegativeResponse&gt;`</DESCRIPTION>
							<TYPE xsi:type="string">DiagResult</TYPE>
