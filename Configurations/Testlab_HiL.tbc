						<DISPLAY-NAME xsi:type="string">Devices</DISPLAY-NAME>
						<DISPLAY-LEVEL xsi:type="integer">0</DISPLAY-LEVEL>
						<DESCRIPTION xsi:type="string">Comma seperated list of used devices</DESCRIPTION>
						<TYPE xsi:type="string">string</TYPE>
						<DEFAULT xsi:type="string">CCP:1, CCP:2, ETKC:1, ETKC-A, ADS:1, CAN-Monitoring:1, CAN-Monitoring:2</DEFAULT>
