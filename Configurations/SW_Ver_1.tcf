<?xml version="1.0" encoding="utf-8"?>
<CONFIGURATION format-rev="9" prog-version="2024.3.0.156114+c108ea21784a" xmlns="http://www.tracetronic.de/xml/ecu-test" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.tracetronic.de/xml/ecu-test application.configuration.xsd">
	<COMMON format-rev="4" xsi:type="commonData">
		<QUERY-TESTER xsi:type="integer">2</QUERY-TESTER>
	</COMMON>
	<REPORT format-rev="4" xsi:type="reportData">
		<REPORT-FORMATES>
			<ELEMENT format-rev="1" xsi:type="reportFormat">
				<FORMAT-NAME xsi:type="string">HTML complete, separate package files</FORMAT-NAME>
				<HANDLER-NAME xsi:type="string">HTML</HANDLER-NAME>
				<FILTERS xsi:type="apiFilter"/>
			</ELEMENT>
			<ELEMENT format-rev="1" xsi:type="reportFormat">
				<FORMAT-NAME xsi:type="string">New EXCEL format</FORMAT-NAME>
				<HANDLER-NAME xsi:type="string">EXCEL</HANDLER-NAME>
				<FILTERS xsi:type="apiFilter"/>
				<PRE-POST-SCRIPT xsi:type="string">user.GenExcelReport2.MyReportPrePostScript</PRE-POST-SCRIPT>
			</ELEMENT>
			<ELEMENT format-rev="1" xsi:type="reportFormat">
				<FORMAT-NAME xsi:type="string">New New_EXCEL format</FORMAT-NAME>
				<HANDLER-NAME xsi:type="string">New_EXCEL</HANDLER-NAME>
				<FILTERS xsi:type="apiFilter"/>
				<CONFIG>
					<ELEMENT dkey="colorResultCells">
						<DVALUE xsi:type="string">True</DVALUE>
					</ELEMENT>
					<ELEMENT dkey="reportName">
						<DVALUE xsi:type="string">Test.xlsx</DVALUE>
					</ELEMENT>
					<ELEMENT dkey="tableFrames">
						<DVALUE xsi:type="string">(2,5,True)</DVALUE>
					</ELEMENT>
					<ELEMENT dkey="testCaseResultStartRow">
						<DVALUE xsi:type="string">18</DVALUE>
					</ELEMENT>
				</CONFIG>
			</ELEMENT>
		</REPORT-FORMATES>
		<INCLUDE-APPLICATION-LOGS xsi:type="boolean">True</INCLUDE-APPLICATION-LOGS>
	</REPORT>
	<EXECUTION-DATA format-rev="2" xsi:type="executionData"/>
	<GLOBAL-CONSTANTS xsi:type="globalConstData">
		<GLOBAL-CONSTANT format-rev="1" xsi:type="globalConstEntry">
			<NAME xsi:type="string">Test</NAME>
			<VALUE format-rev="2" xsi:type="valueBaseExpression">
				<VALUE xsi:type="string">A</VALUE>
			</VALUE>
		</GLOBAL-CONSTANT>
	</GLOBAL-CONSTANTS>
	<MODEL-ACCESS format-rev="1" xsi:type="modelAccessData">
		<DATA dkey="Plant model">
			<DVALUE format-rev="1" xsi:type="modelData">
				<MODEL-DATA-SOURCE xsi:type="integer">0</MODEL-DATA-SOURCE>
				<MODEL-ACCESS-PORT xsi:type="string">MDL01</MODEL-ACCESS-PORT>
				<MODEL-FILE xsi:type="string">EV_HV_HiL.sdf</MODEL-FILE>
				<MODEL-POSITION xsi:type="integer">1</MODEL-POSITION>
			</DVALUE>
		</DATA>
	</MODEL-ACCESS>
	<ECU-ACCESS format-rev="1" xsi:type="ecuAccessData">
		<DATA dkey="Battery-Control">
			<DVALUE format-rev="3" xsi:type="ecuData">
				<APPLICATION-PORT xsi:type="string">APL02</APPLICATION-PORT>
				<A2L-FILE xsi:type="localArtifactReference">
					<PATH xsi:type="string">ECU_Data/Battery-Control.a2l</PATH>
				</A2L-FILE>
				<DIAGNOSTIC-SETTINGS xsi:type="diagSettings"/>
				<ECU-POSITION xsi:type="integer">2</ECU-POSITION>
			</DVALUE>
		</DATA>
		<DATA dkey="Engine-Control">
			<DVALUE format-rev="3" xsi:type="ecuData">
				<APPLICATION-PORT xsi:type="string">APL01</APPLICATION-PORT>
				<A2L-FILE xsi:type="localArtifactReference">
					<PATH xsi:type="string">ECU_Data/Engine-Control.a2l</PATH>
				</A2L-FILE>
				<DIAGNOSTIC-DB xsi:type="string">pdx/VCU1.01(20240930)_11.0.pdx</DIAGNOSTIC-DB>
				<DIAGNOSTIC-SETTINGS xsi:type="diagSettings"/>
				<ECU-POSITION xsi:type="integer">1</ECU-POSITION>
			</DVALUE>
		</DATA>
	</ECU-ACCESS>
	<BUS-ACCESS format-rev="1" xsi:type="busAccessData">
		<DATA dkey="EPT-CAN">
			<DVALUE format-rev="1" xsi:type="busData">
				<BUS-ACCESS-PORT-ACTIVENODE xsi:type="string">BUS01</BUS-ACCESS-PORT-ACTIVENODE>
				<BUS-ACCESS-PORT-SIMULATION xsi:type="string">BUS01</BUS-ACCESS-PORT-SIMULATION>
				<DATABASE xsi:type="localArtifactReference">
					<PATH xsi:type="string">Bus/Electric_V1.DBC</PATH>
				</DATABASE>
				<BUS-POSITION xsi:type="integer">1</BUS-POSITION>
			</DVALUE>
		</DATA>
	</BUS-ACCESS>
</CONFIGURATION>
