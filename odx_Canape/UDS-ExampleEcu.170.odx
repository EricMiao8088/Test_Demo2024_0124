        <DIAG-DATA-DICTIONARY-SPEC>
          <DTC-DOPS>
            <DTC-DOP ID="_74">
              <SHORT-NAME>RecordDataType</SHORT-NAME>
              <LONG-NAME>RecordDataType</LONG-NAME>
              <DIAG-CODED-TYPE BASE-TYPE-ENCODING="NONE" BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                <BIT-LENGTH>24</BIT-LENGTH>
              </DIAG-CODED-TYPE>
              <PHYSICAL-TYPE BASE-DATA-TYPE="A_UINT32" DISPLAY-RADIX="HEX"/>
              <COMPU-METHOD>
                <CATEGORY>IDENTICAL</CATEGORY>
              </COMPU-METHOD>
              <DTCS>
                <DTC ID="_151">
                  <SHORT-NAME>DTC01</SHORT-NAME>
                  <TROUBLE-CODE>1</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>P000001</DISPLAY-TROUBLE-CODE>
                  <TEXT>Voltage too low</TEXT>
                  <SDGS>
                    <SDG>
                      <SDG-CAPTION ID="_152">
                        <SHORT-NAME>SetCondition</SHORT-NAME>
                        <LONG-NAME>Set Condition</LONG-NAME>
                      </SDG-CAPTION>
                      <SD>Voltage &lt; 10V, t &gt; 1s</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION ID="_153">
                        <SHORT-NAME>ResetCondition</SHORT-NAME>
                        <LONG-NAME>Reset condition &amp; self healing</LONG-NAME>
                      </SDG-CAPTION>
                      <SD>U_BAT (of EZS) for t &gt; 15s; Self healing after 100 trips without occurence.</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION ID="_154">
                        <SHORT-NAME>CorrectiveAction</SHORT-NAME>
                        <LONG-NAME>Corrective action</LONG-NAME>
                      </SDG-CAPTION>
                      <SD>No known corrective action</SD>
                    </SDG>
                  </SDGS>
                </DTC>
                <DTC ID="_155">
                  <SHORT-NAME>DTC02</SHORT-NAME>
                  <TROUBLE-CODE>2</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>P000002</DISPLAY-TROUBLE-CODE>
                  <TEXT>Voltage too high</TEXT>
                  <SDGS>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_152"/>
                      <SD>Voltage &gt; 14V, t &gt; 1s</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_153"/>
                      <SD>U_BAT (of EZS) for t &gt; 15s; Self healing after 100 trips without occurence.</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_154"/>
                      <SD>No known corrective action</SD>
                    </SDG>
                  </SDGS>
                </DTC>
                <DTC ID="_156">
                  <SHORT-NAME>DTC03</SHORT-NAME>
                  <TROUBLE-CODE>3</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>P000003</DISPLAY-TROUBLE-CODE>
                  <TEXT>Failure in door contact front left</TEXT>
                  <SDGS>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_152"/>
                      <SD>t &gt; 2s</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_153"/>
                      <SD>ECU Reset (new wake up phase); Self healing after 100 trips without occurence.</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_154"/>
                      <SD>No known corrective action</SD>
                    </SDG>
                  </SDGS>
                </DTC>
                <DTC ID="_157">
                  <SHORT-NAME>DTC04</SHORT-NAME>
                  <TROUBLE-CODE>4</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>P000004</DISPLAY-TROUBLE-CODE>
                  <TEXT>Failure in door contact front right</TEXT>
                  <SDGS>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_152"/>
                      <SD>t &gt; 2s</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_153"/>
                      <SD>ECU Reset (new wake up phase); Self healing after 100 trips without occurence.</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_154"/>
                      <SD>No known corrective action</SD>
                    </SDG>
                  </SDGS>
                </DTC>
                <DTC ID="_158">
                  <SHORT-NAME>DTC05</SHORT-NAME>
                  <TROUBLE-CODE>5</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>P000005</DISPLAY-TROUBLE-CODE>
                  <TEXT>Failure in door contact rear left</TEXT>
                  <SDGS>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_152"/>
                      <SD>t &gt; 2s</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_153"/>
                      <SD>ECU Reset (new wake up phase); Self healing after 100 trips without occurence.</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_154"/>
                      <SD>No known corrective action</SD>
                    </SDG>
                  </SDGS>
                </DTC>
                <DTC ID="_159">
                  <SHORT-NAME>DTC06</SHORT-NAME>
                  <TROUBLE-CODE>6</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>P000006</DISPLAY-TROUBLE-CODE>
                  <TEXT>Failure in door contact rear right</TEXT>
                  <SDGS>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_152"/>
                      <SD>t &gt; 2s</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_153"/>
                      <SD>ECU Reset (new wake up phase); Self healing after 100 trips without occurence.</SD>
                    </SDG>
                    <SDG>
                      <SDG-CAPTION-REF ID-REF="_154"/>
                      <SD>No known corrective action</SD>
                    </SDG>
                  </SDGS>
                </DTC>
