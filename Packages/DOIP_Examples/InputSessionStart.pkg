<?xml version="1.0" encoding="utf-8"?>
<PACKAGE format-rev="7" prog-version="2021.4.119000+a29e29641862" xmlns="http://www.tracetronic.de/xml/ecu-test" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.tracetronic.de/xml/ecu-test package.xsd">
	<INFORMATION format-rev="2" xsi:type="packageInfo">
		<DESCRIPTION xsi:type="string">打开对应控制器的对应会话。

ECU Address【VCCD-1001，L/R/F/TZCU-10C5/6/7/8】
Sessions【10 01 - DefaultSessionStart，10 02 - ProgrammingSessionStart，10 03 - ExtendedDiagnosticSessionStart】</DESCRIPTION>
		<VERSION xsi:type="string"/>
		<ALTERNATE-CALL-REPRESENTATION-ACTION-FIELD-TEMPLATE xsi:type="string"/>
		<ALTERNATE-CALL-REPRESENTATION-EXPECTATION-FIELD-TEMPLATE xsi:type="string"/>
	</INFORMATION>
	<VARIABLES xsi:type="variableContainer">
		<VARIABLE format-rev="1" in="true" xsi:type="variable">
			<NAME xsi:type="string">SessionID</NAME>
			<DEFAULT-VALUE xsi:type="undefined"/>
		</VARIABLE>
		<VARIABLE format-rev="1" xsi:type="variable">
			<NAME xsi:type="string">jobResult</NAME>
			<DEFAULT-VALUE xsi:type="undefined"/>
		</VARIABLE>
		<VARIABLE format-rev="1" in="true" xsi:type="variable">
			<NAME xsi:type="string">targetSession</NAME>
			<DESCRIPTION xsi:type="string">xx:xx格式</DESCRIPTION>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<COMPLEX-DATA xsi:type="I18NItem">
					<MULTILANGDATA>
						<ELEMENT dkey="en_US">
							<DVALUE xsi:type="string">10:01</DVALUE>
						</ELEMENT>
					</MULTILANGDATA>
					<INITIAL-LANGUAGE xsi:type="string">en_US</INITIAL-LANGUAGE>
				</COMPLEX-DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
		<VARIABLE format-rev="1" in="true" xsi:type="variable">
			<NAME xsi:type="string">targetAddress</NAME>
			<DESCRIPTION xsi:type="string">ECU Address【VCCD-1001，L/R/F/TZCU-10C5/6/7/8】</DESCRIPTION>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<COMPLEX-DATA xsi:type="I18NItem">
					<MULTILANGDATA>
						<ELEMENT dkey="en_US">
							<DVALUE xsi:type="string">10:01</DVALUE>
						</ELEMENT>
					</MULTILANGDATA>
					<INITIAL-LANGUAGE xsi:type="string">en_US</INITIAL-LANGUAGE>
				</COMPLEX-DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
	</VARIABLES>
	<MAPPING format-rev="1" xsi:type="localMappingSpace">
		<MAPPING-ITEM format-rev="2" xsi:type="mappingItem">
			<ID xsi:type="string">CallService</ID>
			<XACCESS xsi:type="xaJob">
				<PORT-ID xsi:type="string">DIAG-DOIP01</PORT-ID>
				<JOB-NAME xsi:type="string">CallService</JOB-NAME>
			</XACCESS>
		</MAPPING-ITEM>
	</MAPPING>
	<TESTSTEPS xsi:type="testCase">
		<TESTSTEP format-rev="4" id="48234db0-8ae2-4ca3-b556-67846da20dce" xsi:type="tsJob">
			<MAPPING-REF xsi:type="string">CallService</MAPPING-REF>
			<VARIABLE-REFS>
				<VARIABLE-NAME dkey="default">
					<DVALUE xsi:type="string">jobResult</DVALUE>
				</VARIABLE-NAME>
			</VARIABLE-REFS>
			<JOB-PARAMETER xsi:type="tsJobParameter">
				<NAME xsi:type="string">Request</NAME>
				<EXPRESSION xsi:type="functionBaseExpression">
					<COMPONENT xsi:type="varBaseExpression">
						<NAME xsi:type="string">ByteStream</NAME>
					</COMPONENT>
					<ARGUMENTS>
						<ARGUMENT xsi:type="varBaseExpression">
							<NAME xsi:type="string">targetSession</NAME>
						</ARGUMENT>
					</ARGUMENTS>
				</EXPRESSION>
			</JOB-PARAMETER>
			<JOB-PARAMETER xsi:type="tsJobParameter">
				<NAME xsi:type="string">SessionId</NAME>
				<EXPRESSION xsi:type="varBaseExpression">
					<NAME xsi:type="string">SessionID</NAME>
				</EXPRESSION>
			</JOB-PARAMETER>
			<JOB-PARAMETER xsi:type="tsJobParameter">
				<NAME xsi:type="string">Timeout</NAME>
			</JOB-PARAMETER>
		</TESTSTEP>
		<TESTSTEP id="ad8c75f0-e0f8-4edd-98e3-474c1941c204" name="TsIfThenElse" xsi:type="utility-3609c41e-4fef-11dc-899a-0013728784ee">
			<CONDITION xsi:type="compareOpBaseExpression">
				<NAME xsi:type="string">==</NAME>
				<FIRST-COMPONENT xsi:type="binaryOpBaseExpression">
					<NAME xsi:type="string">BINARY_SUBSCR</NAME>
					<FIRST-COMPONENT xsi:type="attributeBaseExpression">
						<COMPONENT xsi:type="varBaseExpression">
							<NAME xsi:type="string">jobResult</NAME>
						</COMPONENT>
						<ATTR-NAME xsi:type="string">Response</ATTR-NAME>
					</FIRST-COMPONENT>
					<SECOND-COMPONENT format-rev="1" xsi:type="valueBaseExpression">
						<VALUE xsi:type="integer">0</VALUE>
					</SECOND-COMPONENT>
				</FIRST-COMPONENT>
				<SECOND-COMPONENT xsi:type="functionBaseExpression">
					<COMPONENT xsi:type="varBaseExpression">
						<NAME xsi:type="string">BitStream</NAME>
					</COMPONENT>
					<ARGUMENTS>
						<ARGUMENT format-rev="1" xsi:type="valueBaseExpression">
							<VALUE xsi:type="integer">0x50</VALUE>
						</ARGUMENT>
						<ARGUMENT format-rev="1" xsi:type="valueBaseExpression">
							<VALUE xsi:type="integer">8</VALUE>
						</ARGUMENT>
					</ARGUMENTS>
				</SECOND-COMPONENT>
			</CONDITION>
			<THEN id="b0a65060-c40f-431c-ba1a-220385d7aa12" xsi:type="ifThenElseNode">
				<TESTSTEP format-rev="1" id="b83a1d1b-b604-47a0-a43f-6600f2ed0594" name="TsComment" xsi:type="utility-1f4de951-4fef-11dc-969a-0013728784ee">
					<COMMENT-EXPRESSION xsi:type="functionBaseExpression">
						<COMPONENT xsi:type="attributeBaseExpression">
							<COMPONENT format-rev="1" xsi:type="valueBaseExpression">
								<VALUE xsi:type="string">成功进入{0}模式</VALUE>
							</COMPONENT>
							<ATTR-NAME xsi:type="string">format</ATTR-NAME>
						</COMPONENT>
						<ARGUMENTS>
							<ARGUMENT xsi:type="varBaseExpression">
								<NAME xsi:type="string">targetSession</NAME>
							</ARGUMENT>
						</ARGUMENTS>
					</COMMENT-EXPRESSION>
					<COMMENT-VERDICT xsi:type="string">SUCCESS</COMMENT-VERDICT>
				</TESTSTEP>
				<TESTSTEP format-rev="3" id="8478212b-c995-42fe-bec1-aa75ecf556b2" name="TsCalculation" xsi:type="utility-4115fa00-5f3c-11df-8a53-001c233b3528">
					<FORMULA xsi:type="attributeBaseExpression">
						<COMPONENT xsi:type="varBaseExpression">
							<NAME xsi:type="string">jobResult</NAME>
						</COMPONENT>
						<ATTR-NAME xsi:type="string">Response</ATTR-NAME>
					</FORMULA>
				</TESTSTEP>
			</THEN>
			<ELSE id="7e2dfabd-f723-4938-abf9-709b2a0c72bf" xsi:type="ifThenElseNode">
				<TESTSTEP format-rev="1" id="039d6ad2-f759-4451-9cb8-7c20b3b0012a" name="TsComment" xsi:type="utility-1f4de951-4fef-11dc-969a-0013728784ee">
					<COMMENT-EXPRESSION xsi:type="functionBaseExpression">
						<COMPONENT xsi:type="attributeBaseExpression">
							<COMPONENT format-rev="1" xsi:type="valueBaseExpression">
								<VALUE xsi:type="string">未能进入{0}模式</VALUE>
							</COMPONENT>
							<ATTR-NAME xsi:type="string">format</ATTR-NAME>
						</COMPONENT>
						<ARGUMENTS>
							<ARGUMENT xsi:type="varBaseExpression">
								<NAME xsi:type="string">targetSession</NAME>
							</ARGUMENT>
						</ARGUMENTS>
					</COMMENT-EXPRESSION>
					<COMMENT-VERDICT xsi:type="string">FAILED</COMMENT-VERDICT>
				</TESTSTEP>
				<TESTSTEP format-rev="3" id="02506b79-a2b8-4d35-896c-8e040fe54141" name="TsCalculation" xsi:type="utility-4115fa00-5f3c-11df-8a53-001c233b3528">
					<FORMULA xsi:type="attributeBaseExpression">
						<COMPONENT xsi:type="varBaseExpression">
							<NAME xsi:type="string">jobResult</NAME>
						</COMPONENT>
						<ATTR-NAME xsi:type="string">Response</ATTR-NAME>
					</FORMULA>
				</TESTSTEP>
			</ELSE>
		</TESTSTEP>
	</TESTSTEPS>
</PACKAGE>
