									<COMMENT-I18N xsi:type="I18NItem">
										<MULTILANGDATA>
											<ELEMENT dkey="en_US">
												<DVALUE xsi:type="string">'07'是指定的DTC状态位，此处也可以设计成variables。</DVALUE>
											</ELEMENT>
