									<FORMULA xsi:type="binaryOpBaseExpression">
										<NAME xsi:type="string">BINARY_SUBSCR</NAME>
										<FIRST-COMPONENT xsi:type="varBaseExpression">
											<NAME xsi:type="string">DTC_List</NAME>
