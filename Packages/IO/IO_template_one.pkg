					<ARGUMENT xsi:type="varBaseExpression">
						<NAME xsi:type="string">getvalues_str</NAME>
					</ARGUMENT>
				</ARGUMENTS>
			</FORMULA>
		</TESTSTEP>
		<TESTSTEP id="227" name="TsLoop" xsi:type="utility-3da58cf0-4fef-11dc-be56-0013728784ee">
