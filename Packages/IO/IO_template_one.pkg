		<VARIABLE format-rev="1" xsi:type="variable">
			<NAME xsi:type="string">str2list</NAME>
			<DESCRIPTION xsi:type="string"/>
			<DEFAULT-VALUE xsi:type="function">
				<CODE xsi:type="string">import re
# function must be named 'func'

def func(testValues_str):
    testValues_list = list(map(float, re.split(r',', testValues_str)))
    return testValues_list


</CODE>
			</DEFAULT-VALUE>
		</VARIABLE>
		<VARIABLE format-rev="1" xsi:type="variable">
			<NAME xsi:type="string">getvalues_list</NAME>
			<DESCRIPTION xsi:type="string"/>
			<DEFAULT-VALUE xsi:type="pyObject">
