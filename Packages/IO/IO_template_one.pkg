	<TESTSTEPS xsi:type="testCase">
		<TESTSTEP format-rev="3" id="242" name="TsCalculation" xsi:type="utility-4115fa00-5f3c-11df-8a53-001c233b3528">
			<COMMENT-I18N xsi:type="I18NItem">
				<MULTILANGDATA>
					<ELEMENT dkey="en_US">
						<DVALUE xsi:type="string">由于Project的ParameterSet不支持设置python列表类型的变量，只好将testValues先设置为string，再用这一步转为列表，该部使用到了一个python function “str2list”</DVALUE>
					</ELEMENT>
				</MULTILANGDATA>
				<INITIAL-LANGUAGE xsi:type="string">en_US</INITIAL-LANGUAGE>
			</COMMENT-I18N>
			<VARIABLE-REFS>
				<VARIABLE-NAME dkey="default">
					<DVALUE xsi:type="string">testValues_list</DVALUE>
				</VARIABLE-NAME>
			</VARIABLE-REFS>
			<FORMULA xsi:type="functionBaseExpression">
				<COMPONENT xsi:type="varBaseExpression">
					<NAME xsi:type="string">str2list</NAME>
				</COMPONENT>
				<ARGUMENTS>
