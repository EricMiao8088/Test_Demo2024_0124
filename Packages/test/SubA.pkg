	</VARIABLES>
	<MAPPING format-rev="1" xsi:type="localMappingSpace"/>
	<TESTSTEPS xsi:type="testCase">
		<TESTSTEP id="ab6f5daa-0d44-4a2f-9b33-5bf0fbe47955" name="TsLoop" xsi:type="utility-3da58cf0-4fef-11dc-be56-0013728784ee">
